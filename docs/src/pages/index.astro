---
import SiteShell from "../app/providers/site-shell.astro";
import HomeHero from "../widgets/home-hero/home-hero.astro";
import InstallTabs from "../widgets/install-tabs/install-tabs.astro";
import WorkflowOverview from "../widgets/workflow-overview/workflow-overview.astro";
import HomeSignposts from "../widgets/home-signposts/home-signposts.astro";
---

<SiteShell
  title="type-tune"
  description="Move shared TypeScript types without breaking imports. Review deterministic plans before applying Rust-powered, validated rewrites."
>
  <div class="home-page">
    <HomeHero />
    <InstallTabs />
    <WorkflowOverview />
    <HomeSignposts />
  </div>
</SiteShell>

<style>
  .home-page {
    width: min(70%, 86rem);
    margin-inline: auto;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.8;
  }

  .home-page :global(.heading) {
    font-family: Optima, "Source Sans 3 Variable", "Source Sans 3", sans-serif;
    font-size: 48px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.15;
  }

  @media (min-width: 801px) and (max-width: 1100px) {
    .home-page {
      width: 78%;
    }
  }

  @media (max-width: 800px) {
    .home-page {
      width: 68%;
      max-width: 28rem;
      font-size: 12px;
    }
    .home-page :global(.heading) {
      font-size: clamp(28px, 7.5vw, 36px);
    }
  }

  @media (max-width: 360px) {
    .home-page {
      width: 72%;
    }
  }
</style>
