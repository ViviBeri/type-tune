---
import type { GetStaticPaths } from "astro";
import type { CliOptionSection } from "../../entities/cli-option/model.js";
import SiteShell from "../../app/providers/site-shell.astro";
import { cliOptionSections } from "../../shared/config/cli-options.js";
import Callout from "../../shared/ui/callout.astro";
import CodeBlock from "../../shared/ui/code-block.astro";
import Heading from "../../shared/ui/heading.astro";
import PageHeader from "../../shared/ui/page-header.astro";
import TextLink from "../../shared/ui/text-link.astro";
import ConfigTable from "../../widgets/config-table/config-table.astro";

interface Props {
  section: CliOptionSection;
}

export const getStaticPaths = (() =>
  cliOptionSections.map((section) => ({
    params: { section: section.id },
    props: { section },
  }))) satisfies GetStaticPaths;

const { section } = Astro.props;
const description = `Reference for type-tune ${section.title}, including accepted values and defaults.`;
const showsSharedNotes = section.id === "shared-options";
const showsPlanNotes = section.id === "plan-options";
const showsApplyNotes = section.id === "apply-options";
const showsAiReviewNotes = section.id === "ai-review-options";
---

<SiteShell title={section.title} description={description} withSidebar>
  <article class="config-page">
    <PageHeader
      eyebrow="Config"
      title={section.title}
      lead={section.description ?? "Accepted command options, value formats, and resolved defaults."}
    />

    {showsSharedNotes && (
      <Callout>
        Scan reads <code>.ts</code> and <code>.tsx</code> files from the selected
        <code>tsconfig.json</code>. Generated paths and declarations already under a
        <code>types</code> directory, or in a file named <code>types.ts</code>, are excluded by
        default. Opt in only when those sources should participate in the move.
      </Callout>
    )}

    {showsPlanNotes && (
      <Callout>
        Leave <code>plan.json</code> unchanged. <code>plan.md</code> is the review surface for
        <code>[apply]</code> or <code>[ignore]</code> and for an edited <code>to:</code> path. The
        <TextLink href="/usage/workflow">workflow guide</TextLink> explains the destination rules.
      </Callout>
    )}

    {showsApplyNotes && (
      <Callout>
        Apply requires <code>--markdown</code> or the explicit <code>--accept-unreviewed</code> flag.
        With Markdown, <code>[apply]</code> / <code>[ignore]</code> and any edited <code>to:</code>
        path come from <code>plan.md</code>. Without Markdown, <code>--accept-unreviewed</code> uses
        the statuses already stored in <code>plan.json</code>.
      </Callout>
    )}

    {showsAiReviewNotes && (
      <Callout>
        AI review is optional and never rewrites source. <code>--ai-dry-run</code> prints or saves
        the request without contacting a provider. A real OpenAI, OpenAI-compatible, or Anthropic
        review sends the selected context to that provider. Ollama defaults to
        <code>http://127.0.0.1:11434/api/chat</code>. The mock provider reads
        <code>--ai-response-file</code> locally. Redaction masks common secret assignments on a
        best-effort basis and does not guarantee that sensitive data is removed.
      </Callout>
    )}

    <ConfigTable section={section} showHeading={false} />

    {showsSharedNotes && (
      <section class="content-section prose">
        <Heading>Path alias behavior</Heading>
        <p>
          type-tune reads <code>compilerOptions.baseUrl</code> and <code>compilerOptions.paths</code>
          from the loaded TypeScript project. When an existing alias can still address the
          destination, rewritten imports keep that style. Otherwise, a project-relative import is
          used.
        </p>
        <CodeBlock code={`pnpm exec type-tune extract OrderSummary \\
  --from src/features/order/schema.ts \\
  --to src/features/order/types/order.ts \\
  --project tsconfig.json \\
  --dry-run`} />
      </section>
    )}

    {showsAiReviewNotes && (
      <section class="content-section prose">
        <Heading>Inspect the request before sending</Heading>
        <p>
          Use a dry run to write the provider request without making a network call. Review the JSON
          and remove source that contains secrets or other data the provider must not receive.
        </p>
        <CodeBlock code={`pnpm exec type-tune plan \\
  --project tsconfig.json \\
  --ai-review \\
  --ai-dry-run \\
  --ai-request-out .type-tune/ai-request.json`} />
      </section>
    )}
  </article>
</SiteShell>

<style>
  .config-page {
    max-width: 62rem;
  }

  .config-page > .callout {
    margin-top: 2rem;
  }

  .content-section > p {
    color: var(--muted);
  }
</style>
