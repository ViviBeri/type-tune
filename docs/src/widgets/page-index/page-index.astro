---
type PageIndexItem = {
  /** Link destination. */
  href: string;
  /** Linked page title. */
  title: string;
  /** Summary of the linked page. */
  description: string;
  /** Action label shown after the summary, before the decorative arrow. */
  action: string;
};

interface Props {
  /** Accessible navigation label. */
  label: string;
  /** Pages presented in the index. */
  items: PageIndexItem[];
  /** Whether card titles use title casing. */
  capitalizeTitles?: boolean;
}

const { label, items, capitalizeTitles = false } = Astro.props;
---

<nav class:list={["page-index", { "page-index--capitalize": capitalizeTitles }]} aria-label={label}>
  <ul>
    {items.map((item) => (
      <li>
        <a class="pixel-frame" href={item.href}>
          <h2>{item.title}</h2>
          <p>{item.description}</p>
          <span class="page-index__action link-underline">{item.action} <span class="page-index__arrow" aria-hidden="true">→</span></span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .page-index {
    margin-top: 2.5rem;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.85rem;
    height: 100%;
    padding: 1.75rem;
    --pixel-frame-color: var(--secondary);
    --pixel-frame-fill: var(--background);
  }

  a:is(:hover, :focus-visible) {
    --pixel-frame-color: var(--primary);
    --pixel-frame-fill: var(--secondary);
  }

  a:is(:hover, :focus-visible) .page-index__action::after {
    width: calc(100% + 0.2em);
  }

  .page-index__arrow {
    display: inline-block;
    transition: transform 160ms ease;
  }

  a:is(:hover, :focus-visible) .page-index__arrow {
    transform: translateX(0.2em);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    font-size: 1.35rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .page-index--capitalize h2 {
    text-transform: capitalize;
  }

  p {
    color: var(--primary);
    font-size: 1rem;
  }

  .page-index__action {
    display: inline-block;
    justify-self: start;
    margin-top: 0.75rem;
    color: var(--primary);
    font-size: 0.9rem;
    font-weight: 650;
  }

  @media (max-width: 800px) {
    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
