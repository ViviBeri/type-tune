---
import { installCommands } from "../../shared/config/install-commands.js";
import CodeTabs from "../../shared/ui/code-tabs.astro";
import Heading from "../../shared/ui/heading.astro";
import HomeArt from "../../shared/ui/home-art.astro";
---
<section class="install-section" id="install">
  <div class="install-section__copy">
    <Heading>Install</Heading>
    <p>
      Add type-tune to a project that uses <strong>Node.js 22+</strong>. A one-off scan is
      <code>npx type-tune scan --project tsconfig.json</code>. After a local install, run
      <code>pnpm exec type-tune</code> or <code>npx type-tune</code>.
    </p>
    <p>
      <a class="link-underline" href="/usage/getting-started">See supported platforms and the first scan <span aria-hidden="true">→</span></a>
    </p>
  </div>
  <CodeTabs commands={installCommands} decoration="dust" />
  <div class="install-section__dust" aria-hidden="true">
    <HomeArt name="dust-01" width={92} height={81} mobileWidth={38} mobileHeight={34} />
  </div>
  <div class="install-section__crab" aria-hidden="true">
    <HomeArt src="/animation/type-crab.gif" width={135} height={128} mobileWidth={62} mobileHeight={59} />
  </div>
</section>
<style>
  .install-section {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    align-items: center;
    gap: 6rem;
    padding-block: 3rem 10rem;
  }
  p {
    margin: 1.5rem 0 0;
  }
  code {
    font: inherit;
    overflow-wrap: anywhere;
  }
  .install-section__dust {
    position: absolute;
    bottom: -2rem;
    left: -7rem;
  }
  .install-section__crab {
    position: absolute;
    top: 0;
    left: -7rem;
    transform: translateY(-100%);
  }
  @media (max-width: 800px) {
    .install-section {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-block: 0 7rem;
    }
    .install-section__crab {
      top: -5rem;
      bottom: auto;
      left: -2rem;
      transform: none;
    }
    .install-section__dust {
      top: auto;
      bottom: 2rem;
      left: 1rem;
    }
    p {
      margin-top: 1rem;
    }
  }
</style>
