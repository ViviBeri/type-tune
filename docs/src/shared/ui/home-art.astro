---
interface Props {
  /** Asset name shared by PC and smartphone illustrations. */
  name?: string;
  /** Shared asset for both breakpoints, such as an animation. */
  src?: string;
  /** Desktop width. */
  width: number;
  /** Desktop height. */
  height: number;
  /** Smartphone width. */
  mobileWidth: number;
  /** Smartphone height. */
  mobileHeight: number;
  /** Accessible description; empty for decorative illustrations. */
  alt?: string;
}
const { name, src, width, height, mobileWidth, mobileHeight, alt = "" } = Astro.props;
const desktopSrc = src ?? `/parts/type-tune-pc-${name}.png`;
const mobileSrc = src ?? `/parts/type-tune-smartphone-${name}.png`;
---
<picture style={`--art-width: ${width}px; --art-mobile-width: ${mobileWidth}px`}>
  <source media="(max-width: 800px)" srcset={mobileSrc} width={mobileWidth} height={mobileHeight} />
  <img src={desktopSrc} width={width} height={height} alt={alt} />
</picture>
<style>
  picture {
    display: block;
    width: var(--art-width);
    max-width: 100%;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 800px) {
    picture {
      width: var(--art-mobile-width);
    }
  }
</style>
